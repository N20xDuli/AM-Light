[object, uuid(68e7097c-f969-4006-aac3-95115f0ed1c4), pointer_default(unique)]
interface IAMPMusicLibrary : IInspectable {
}

[object, uuid(f707a913-e0ce-4fd4-bce3-425dd153285b), pointer_default(unique)]
interface IAMPLibrary : IInspectable {
    HRESULT get_Version([out, retval] HSTRING* value);
    HRESULT get_ServerInfo([out, retval] HSTRING* value);
    HRESULT get_State([out, retval] INT32* value);
    HRESULT Setup([in] UINT32 inAppProcessID, [out] UINT32* outAgentProcessID, [out, retval] INT32* result);
    HRESULT Cleanup([in] UINT32 inAppProcessID, [out, retval] INT32* result);
    HRESULT MediaAppStarting([in] INT32 inAppKind, [out, retval] HSTRING* result);
    HRESULT MediaAppQuitting([out, retval] INT32* result);
    HRESULT MediaAppGetLibraryInfoAsync([out, retval] IAsyncOperation_HSTRING** operation);
    HRESULT MediaAppOpenLibraryAsync([out, retval] IAsyncOperation_HSTRING** operation);
    HRESULT MediaAppSetLibraryLocationAsync([in] HSTRING paramsDict, [out, retval] IAsyncOperation_HSTRING** operation);
    HRESULT MediaAppExecFetchRequestAsync([in] HSTRING fetchDataVec, [out, retval] IAsyncOperation_HSTRING** operation);
    HRESULT MediaAppReleaseFetchRequestWriteStream([in] UINT64 inDBID, [in] UINT64 inFID, [out, retval] INT32* result);
    HRESULT MediaAppCloseFetchRequest([in] UINT64 inDBID, [in] UINT64 inFID, [out, retval] INT32* result);
    HRESULT MediaAppExecAgentCommandAsync([in] HSTRING cmdDataDict, [out, retval] IAsyncOperation_HSTRING** operation);
    HRESULT get_ClientID([out, retval] UINT32* value);
    HRESULT get_MediaDomainsOpened([out, retval] boolean* value);
    HRESULT get_ServerProtocolVersion([out, retval] HSTRING* value);
    HRESULT RegisterLibraryClient([in] HSTRING clientName, [in] UINT32 clientID, [out, retval] RegisterClientResult* result);
    HRESULT GetDomainInfoAsync([in] UINT32 mediaDomains, [in] UINT32 clientID, [in] HSTRING paramsDict, [out, retval] IAsyncOperation_HSTRING** operation);
    HRESULT OpenDomainsAsync([in] UINT32 mediaDomains, [in] UINT32 clientID, [in] HSTRING paramsDict, [out, retval] IAsyncOperation_HSTRING** operation);
    HRESULT CloseDomainsForClientID([in] UINT32 clientID, [out, retval] INT32* result);
    HRESULT SendDBChangesToLibraryAsync([in] UINT32 fromRevision, [in] HSTRING paramsDict, [out, retval] IAsyncOperation_HSTRING** operation);
    HRESULT FetchLibraryFromRevsionAsync([in] UINT32 fromRevision, [in] UINT32 mediaDomains, [in] boolean initialLoad, [out, retval] IAsyncOperation_HSTRING** operation);
    HRESULT SaveAgentLogToFileAsync([in] HSTRING logFolder, [in] HSTRING logFilename, [out, retval] IAsyncOperation_HSTRING** operation);
    HRESULT add_PlaybackEventHandler([in] IPlaybackEventDelegate* handler, [out, retval] EventRegistrationToken* token);
    HRESULT remove_PlaybackEventHandler([in] EventRegistrationToken token);
    HRESULT add_PlaybackEventWithCallbackHandler([in] IPlaybackEventWithCallbackDelegate* handler, [out, retval] EventRegistrationToken* token);
    HRESULT remove_PlaybackEventWithCallbackHandler([in] EventRegistrationToken token);
    HRESULT PlaybackEventResponse([in] UINT32 inEventID, [in] HSTRING inResponseDict);
    HRESULT add_FetchInvalidationHandler([in] IFetchInvalidationEventDelegate* handler, [out, retval] EventRegistrationToken* token);
    HRESULT remove_FetchInvalidationHandler([in] EventRegistrationToken token);
    HRESULT add_ActivityStateHandler([in] IActvityStateEventDelegate* handler, [out, retval] EventRegistrationToken* token);
    HRESULT remove_ActivityStateHandler([in] EventRegistrationToken token);
    HRESULT add_CloudLibraryEventHandler([in] ICloudLibraryEventDelegate* handler, [out, retval] EventRegistrationToken* token);
    HRESULT remove_CloudLibraryEventHandler([in] EventRegistrationToken token);
    HRESULT add_LibraryEventHandler([in] ILibraryEventDelegate* handler, [out, retval] EventRegistrationToken* token);
    HRESULT remove_LibraryEventHandler([in] EventRegistrationToken token);
    HRESULT add_StoreServicesUIEventHandler([in] IStoreServicesUIEventDelegate* handler, [out, retval] EventRegistrationToken* token);
    HRESULT remove_StoreServicesUIEventHandler([in] EventRegistrationToken token);
    HRESULT StoreServicesUIEventResponse([in] UINT32 inEventID, [in] HSTRING inResponseDict);
    HRESULT add_BusyChangedHandler([in] IBusyChangedEventDelegate* handler, [out, retval] EventRegistrationToken* token);
    HRESULT remove_BusyChangedHandler([in] EventRegistrationToken token);
    HRESULT add_LibraryRevisionChangedHandler([in] ILibraryRevisionChangedEventDelegate* handler, [out, retval] EventRegistrationToken* token);
    HRESULT remove_LibraryRevisionChangedHandler([in] EventRegistrationToken token);
    HRESULT add_DeviceEventHandler([in] IDeviceEventDelegate* handler, [out, retval] EventRegistrationToken* token);
    HRESULT remove_DeviceEventHandler([in] EventRegistrationToken token);
    HRESULT Kill();
}
