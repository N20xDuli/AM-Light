import "unknwn.idl";
import "inspectable.idl";
import "hstring.idl";
import "eventtoken.idl";

typedef [v1_enum] enum AMPLibraryAppKinds {
    AMPLibraryAppKind_Music = 1,
    AMPLibraryAppKind_TV = 2
} AMPLibraryAppKinds;

typedef [v1_enum] enum AMPLibraryMediaDomains {
    AMPLibraryMediaDomainsNone = 0,
    AMPLibraryMediaDomainsMusic = 1,
    AMPLibraryMediaDomainsTVAndMovies = 2,
    AMPLibraryMediaDomainsWinAll = 3,
    AMPLibraryMediaDomainsPodcasts = 4,
    AMPLibraryMediaDomainsBooks = 8,
    AMPLibraryMediaDomainsAll = 15
} AMPLibraryMediaDomains;

typedef [v1_enum] enum AMPLibraryState {
    eUnknown = 0,
    eSetup = 1,
    eStarting = 2,
    eStarted = 3,
    eStopping = 4,
    eStopped = 5,
    eShutdown = 6
} AMPLibraryState;

typedef struct RegisterClientResult {
    UINT32 clientID;
    UINT64 persistentMachineID;
    INT32 status;
} RegisterClientResult;

[object, uuid(3e1fe603-f897-5263-b328-0806426b8a79), pointer_default(unique)]
interface IAsyncOperation_HSTRING : IInspectable {
}

